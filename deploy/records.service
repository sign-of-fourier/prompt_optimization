# The demo external step (EXTERNAL-STEPS.md §10). Its own process, its own port, its own key: the studio reaches it
# over HTTP exactly as it would reach a third party.
#   sudo cp deploy/records.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now records
[Unit]
Description=Customer records (demo external step for Impromptune)
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/projects/prompt_optimization/steps/records
Environment=PATH=/home/ubuntu/miniconda3/bin:/usr/bin:/bin
# The key the studio must hold to call this service. Change it, and add the same value as the step's credential.
Environment=RECORDS_API_KEY=records-demo-key
ExecStart=/home/ubuntu/miniconda3/bin/uvicorn service:app --host 127.0.0.1 --port 8200
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
