# www -> apex
server {
    server_name www.promptcompression.ai;
    return 301 https://promptcompression.ai$request_uri;

    listen 443 ssl default_server; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/promptcompression.ai/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/promptcompression.ai/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}

server {
    server_name promptcompression.ai;

    root /home/ubuntu/projects/prompt_compression;
    index index.html;

    types {
        text/html html; text/css css; image/svg+xml svg; image/png png;
        text/plain txt; text/markdown md; application/xml xml; application/json json;
    }
    charset utf-8;

    location ~ \.py$ { return 404; }

    location /img/ { expires 30d; }

    # old .html paths -> clean URLs (checked on the original request only, so index.html internals don't loop)
    if ($request_uri ~ ^/index\.html$) { return 301 /; }
    if ($request_uri ~ ^/(.+)\.html$) { return 301 /$1; }

    location / {
        try_files $uri $uri.html $uri/ =404;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/promptcompression.ai/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/promptcompression.ai/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot


}


server {
    if ($host = promptcompression.ai) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80 default_server;
    server_name promptcompression.ai;
    return 301 https://promptcompression.ai$request_uri;


}
server {
    if ($host = www.promptcompression.ai) {
        return 301 https://promptcompression.ai$request_uri;
    } # managed by Certbot (edited: straight to apex)


    listen 80;
    server_name www.promptcompression.ai;
    return 404; # managed by Certbot


}
# retired site: send adstackers.com visitors to promptcompression.ai (own cert kept so https doesn't error)
server {
    listen 80;
    server_name adstackers.com www.adstackers.com;
    return 301 https://promptcompression.ai$request_uri;
}
server {
    listen 443 ssl;
    server_name adstackers.com www.adstackers.com;
    ssl_certificate /etc/letsencrypt/live/adstackers.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/adstackers.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
    return 301 https://promptcompression.ai$request_uri;
}
